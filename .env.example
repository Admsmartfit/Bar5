# Copie para .env (o ./instalar.sh faz isso e gera senhas aleatórias sozinho).
# O arquivo .env NUNCA vai para o Git.

# --- Banco de dados ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=troque-esta-senha
BOTECO_DB=boteco

# Senha mestra do Odoo (gerenciador de bancos). Guarde em local seguro.
ODOO_ADMIN_PASSWD=troque-esta-senha-mestra

# Senha inicial do usuário "admin" (dono). Troque no primeiro acesso.
ODOO_ADMIN_USER_PASSWORD=troque-no-primeiro-acesso

# --- Rede ---
BOTECO_HOSTNAME=boteco.local
# Faixas de IP da rede Wi-Fi dos CLIENTES (QR Code só pede de dentro dela). Separe por vírgula.
REDE_CLIENTES=192.168.20.0/24
# Faixas da rede do SISTEMA (tablets das mesas, garçons, caixa, cozinha).
REDE_SISTEMA=192.168.10.0/24

# --- Empresa (usado na primeira configuração) ---
EMPRESA_NOME="Boteco Raiz"
EMPRESA_CNPJ=
EMPRESA_CIDADE=
# "uma" = bar e cozinha central na mesma empresa (2 armazéns)
# "duas" = bar e cozinha central como empresas (CNPJs) separadas
EMPRESA_MODO=uma
COZINHA_NOME="Cozinha Central Boteco Raiz"
COZINHA_CNPJ=

# --- Backup ---
# Pasta do segundo disco (montado no host)
BACKUP_DIR=/mnt/backup-boteco
BACKUP_RETENCAO_DIAS=30
BACKUP_INTERVALO_MIN=60
# Destino rclone para o backup diário na nuvem (ex.: gdrive:boteco-backup). Vazio = desligado.
BACKUP_NUVEM_DESTINO=
# Senha de criptografia do backup na nuvem (GPG simétrico). OBRIGATÓRIA se usar nuvem.
BACKUP_NUVEM_SENHA=

# --- Desempenho (mini PC 16 GB) ---
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=1
