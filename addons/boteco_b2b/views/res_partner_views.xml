<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_b2b" model="ir.ui.view">
        <field name="name">res.partner.form.boteco.b2b</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_boteco_repetir_ultimo_pedido" type="object" class="oe_stat_button" icon="fa-repeat"
                        invisible="not boteco_cliente_b2b" string="Repetir último pedido"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Bar cliente" name="boteco_b2b">
                    <group>
                        <group>
                            <field name="boteco_cliente_b2b"/>
                            <field name="boteco_ie"/>
                            <field name="property_product_pricelist" string="Tabela de preço"/>
                            <field name="property_payment_term_id" string="Prazo de pagamento"/>
                        </group>
                        <group>
                            <field name="boteco_ultima_compra"/>
                            <field name="boteco_kg_comprados"/>
                            <field name="boteco_total_comprado"/>
                            <field name="boteco_dias_alerta"/>
                            <field name="boteco_parado"/>
                        </group>
                    </group>
                    <field name="boteco_contrato_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="estado"/>
                            <field name="valor_mensal"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_list_b2b" model="ir.ui.view">
        <field name="name">res.partner.list.boteco.b2b</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Bares clientes" decoration-danger="boteco_parado">
                <field name="name"/>
                <field name="vat" string="CNPJ"/>
                <field name="phone"/>
                <field name="boteco_ultima_compra"/>
                <field name="boteco_kg_comprados"/>
                <field name="boteco_total_comprado" sum="Total"/>
                <field name="boteco_parado"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_boteco_repetir_ultimo_pedido" type="object" string="Repetir pedido" icon="fa-repeat"/>
            </list>
        </field>
    </record>

    <record id="action_bares_clientes" model="ir.actions.act_window">
        <field name="name">Bares clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('boteco_cliente_b2b', '=', True)]</field>
        <field name="context">{'default_boteco_cliente_b2b': True, 'default_is_company': True}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('res_partner_list_b2b')})]"/>
    </record>
</odoo>
