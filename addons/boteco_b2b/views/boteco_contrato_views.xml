<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boteco_contrato_view_list" model="ir.ui.view">
        <field name="name">boteco.contrato.assessoria.list</field>
        <field name="model">boteco.contrato.assessoria</field>
        <field name="arch" type="xml">
            <list string="Contratos de assessoria" decoration-muted="estado == 'encerrado'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="data_inicio"/>
                <field name="valor_mensal" sum="Mensal"/>
                <field name="proxima_competencia"/>
                <field name="estado" widget="badge" decoration-success="estado == 'ativo'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="boteco_contrato_view_form" model="ir.ui.view">
        <field name="name">boteco.contrato.assessoria.form</field>
        <field name="model">boteco.contrato.assessoria</field>
        <field name="arch" type="xml">
            <form string="Contrato de assessoria">
                <header>
                    <button name="action_ativar" type="object" string="Ativar e cobrar implantação" class="btn-primary"
                            invisible="estado != 'rascunho'"/>
                    <button name="action_encerrar" type="object" string="Encerrar" invisible="estado != 'ativo'"
                            confirm="Encerrar o contrato? As mensalidades param de ser geradas."/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_cobrancas" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="faturas_count" widget="statinfo" string="Cobranças"/>
                        </button>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="data_inicio"/>
                            <field name="dia_vencimento"/>
                        </group>
                        <group>
                            <field name="valor_implantacao"/>
                            <field name="valor_mensal"/>
                            <field name="proxima_competencia"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_boteco_contrato" model="ir.actions.act_window">
        <field name="name">Contratos de assessoria</field>
        <field name="res_model">boteco.contrato.assessoria</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
