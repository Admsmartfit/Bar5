<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_lot_list_boteco" model="ir.ui.view">
        <field name="name">stock.lot.list.boteco</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">boteco_situacao == 'vencendo'</attribute>
                <attribute name="decoration-danger">boteco_situacao == 'vencido'</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="boteco_fabricacao" optional="show"/>
                <field name="expiration_date" optional="show"/>
                <field name="boteco_peso" optional="show"/>
                <field name="boteco_situacao" widget="badge" decoration-warning="boteco_situacao == 'vencendo'"
                       decoration-danger="boteco_situacao == 'vencido'" decoration-success="boteco_situacao == 'ok'"/>
            </xpath>
        </field>
    </record>

    <record id="stock_lot_form_boteco" model="ir.ui.view">
        <field name="name">stock.lot.form.boteco</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_boteco_etiqueta" type="object" string="Reimprimir etiqueta" invisible="not boteco_producao_id"/>
                </header>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="inside">
                <group string="Cozinha central">
                    <field name="boteco_fabricacao"/>
                    <field name="boteco_peso"/>
                    <field name="boteco_producao_id"/>
                    <field name="boteco_situacao"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="stock_lot_search_boteco" model="ir.ui.view">
        <field name="name">stock.lot.search.boteco</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="boteco_vencendo" string="Vence em 3 dias" domain="[('boteco_situacao', '=', 'vencendo')]"/>
                <filter name="boteco_vencidos" string="Vencidos" domain="[('boteco_situacao', '=', 'vencido')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_boteco_lotes" model="ir.actions.act_window">
        <field name="name">Lotes</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_id.boteco_produzido_cozinha', '=', True)]</field>
    </record>

    <record id="stock_picking_form_boteco" model="ir.ui.view">
        <field name="name">stock.picking.form.boteco</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_boteco_abrir_separacao" type="object" string="Separar lendo QR" class="btn-primary"
                        invisible="state in ('done', 'cancel') or boteco_separado"/>
                <button name="action_boteco_confirmar_recebimento" type="object" string="Confirmar recebimento no bar"
                        class="btn-success" invisible="state in ('done', 'cancel') or not boteco_separado or picking_type_code != 'internal'"/>
                <field name="boteco_separado" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
