<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boteco_equipamento_view_list" model="ir.ui.view">
        <field name="name">boteco.equipamento.list</field>
        <field name="model">boteco.equipamento</field>
        <field name="arch" type="xml">
            <list string="Equipamentos de frio" editable="bottom">
                <field name="name"/>
                <field name="tipo"/>
                <field name="temperatura_min"/>
                <field name="temperatura_max"/>
                <field name="warehouse_id"/>
            </list>
        </field>
    </record>
    <record id="action_boteco_equipamento" model="ir.actions.act_window">
        <field name="name">Freezers e câmaras</field>
        <field name="res_model">boteco.equipamento</field>
        <field name="view_mode">list</field>
    </record>

    <record id="boteco_temperatura_view_list" model="ir.ui.view">
        <field name="name">boteco.temperatura.list</field>
        <field name="model">boteco.temperatura</field>
        <field name="arch" type="xml">
            <list string="Temperaturas" editable="top" decoration-danger="fora_da_faixa">
                <field name="data"/>
                <field name="equipamento_id"/>
                <field name="temperatura"/>
                <field name="fora_da_faixa"/>
                <field name="acao_corretiva" required="fora_da_faixa"/>
                <field name="responsavel_id"/>
            </list>
        </field>
    </record>
    <record id="boteco_temperatura_view_search" model="ir.ui.view">
        <field name="name">boteco.temperatura.search</field>
        <field name="model">boteco.temperatura</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipamento_id"/>
                <filter name="fora" string="Fora da faixa" domain="[('fora_da_faixa', '=', True)]"/>
                <filter name="este_mes" string="Este mês" domain="[('data', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group>
                    <filter name="por_equipamento" string="Equipamento" context="{'group_by': 'equipamento_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_boteco_temperatura" model="ir.actions.act_window">
        <field name="name">Temperaturas</field>
        <field name="res_model">boteco.temperatura</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_este_mes': 1}</field>
        <field name="help" type="html">
            <p>Todo dia: toque em Novo, escolha o freezer e digite a temperatura. Fora da faixa fica vermelho e pede a ação.</p>
        </field>
    </record>
</odoo>
