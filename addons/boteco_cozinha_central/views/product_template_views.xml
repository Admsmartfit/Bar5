<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_cozinha" model="ir.ui.view">
        <field name="name">product.template.form.boteco.cozinha</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cozinha central" name="boteco_cozinha">
                    <group>
                        <group>
                            <field name="boteco_produzido_cozinha"/>
                            <field name="boteco_conservacao" invisible="not boteco_produzido_cozinha"/>
                            <field name="boteco_dias_cobertura" invisible="not boteco_produzido_cozinha"/>
                        </group>
                        <group invisible="not boteco_produzido_cozinha">
                            <field name="expiration_time" string="Validade congelado (dias)"/>
                            <field name="boteco_validade_resfriado_dias"/>
                        </group>
                        <group string="Capacidade e reserva" invisible="not boteco_produzido_cozinha">
                            <field name="boteco_lote_max_diario"/>
                            <field name="boteco_volume_freezer_litros"/>
                            <field name="boteco_estoque_min_bar"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Etapa 34: aviso no cadastro rápido do cardápio (congelado x frito) -->
    <record id="product_template_form_rapido_aviso_producao" model="ir.ui.view">
        <field name="name">product.template.form.boteco.rapido.aviso.producao</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="boteco_cardapio.product_template_view_form_rapido"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="boteco_aviso_producao" invisible="1"/>
            </xpath>
            <xpath expr="//sheet/div[1]" position="before">
                <div class="alert alert-info mb-2" role="status" invisible="not boteco_aviso_producao">
                    <i class="fa fa-info-circle" title="Aviso"/> <field name="boteco_aviso_producao" readonly="1" class="d-inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
