<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_fiscal" model="ir.ui.view">
        <field name="name">res.company.form.boteco.fiscal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="boteco_base.res_company_view_form_boteco"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='boteco']/group" position="after">
                <group string="Fiscal">
                    <field name="boteco_fiscal_dias_alerta"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
