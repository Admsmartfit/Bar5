<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_reservas_lembretes" model="ir.cron">
        <field name="name">Boteco: lembretes de reserva</field>
        <field name="model_id" ref="model_boteco_reserva"/>
        <field name="state">code</field>
        <field name="code">model._cron_lembretes()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_reservas_no_show" model="ir.cron">
        <field name="name">Boteco: no-show de reservas</field>
        <field name="model_id" ref="model_boteco_reserva"/>
        <field name="state">code</field>
        <field name="code">model._cron_no_show()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
