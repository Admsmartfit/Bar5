<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QR Code de cada mesa em PDF: um cartão por mesa, para plastificar -->
    <record id="report_qr_mesas" model="ir.actions.report">
        <field name="name">QR Code das mesas</field>
        <field name="model">pos.config</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">boteco_cardapio.qr_mesas_documento</field>
        <field name="report_file">boteco_cardapio.qr_mesas_documento</field>
        <field name="print_report_name">'QR das mesas - %s' % object.name</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_config"/>
        <field name="binding_type">report</field>
    </record>

    <template id="qr_mesas_documento">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="config">
                <t t-set="grupos" t-value="config._get_qr_code_data()"/>
                <t t-foreach="grupos" t-as="grupo">
                    <div class="page">
                        <h2 style="text-align:center" t-esc="grupo['name']"/>
                        <div style="display:flex;flex-wrap:wrap;justify-content:space-around">
                            <t t-foreach="grupo['tables']" t-as="mesa">
                                <div style="width:45%;border:2px dashed #999;border-radius:12px;margin:10px;padding:14px;text-align:center;page-break-inside:avoid">
                                    <div style="font-size:16px;color:#555" t-esc="config.company_id.name"/>
                                    <div style="font-size:42px;font-weight:800">
                                        Mesa <t t-esc="mesa.get('name') or mesa.get('id')"/>
                                    </div>
                                    <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=260&amp;height=260' % mesa['url']"
                                         style="width:260px;height:260px"/>
                                    <div style="font-size:18px;font-weight:700;margin-top:6px">Aponte a câmera e peça pelo celular</div>
                                    <div style="font-size:12px;color:#555;margin-top:4px">
                                        Conecte-se ao Wi-Fi do bar. O garçom libera seu celular no primeiro pedido.
                                    </div>
                                    <div style="font-size:10px;color:#777;margin-top:6px">
                                        Privacidade: não pedimos cadastro. Telefone e CPF só se você informar, para a nota fiscal.
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
