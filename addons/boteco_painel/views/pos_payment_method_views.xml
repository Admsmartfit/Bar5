<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_form_boteco" model="ir.ui.view">
        <field name="name">pos.payment.method.form.boteco</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Boteco">
                    <field name="boteco_taxa_pct"/>
                    <field name="boteco_dias_recebimento"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
