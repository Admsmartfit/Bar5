<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_metas" model="ir.ui.view">
        <field name="name">res.company.form.boteco.metas</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="boteco_base.res_company_view_form_boteco"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='boteco']/group" position="after">
                <group string="Metas do plano de negócios">
                    <field name="boteco_meta_clientes_noite"/>
                    <field name="boteco_meta_kg_b2b_mes"/>
                    <field name="boteco_meta_bares_assessoria"/>
                </group>
                <group string="Rateio da taxa de serviço (soma 100%)">
                    <field name="boteco_rateio_garcom_pct"/>
                    <field name="boteco_rateio_producao_pct"/>
                    <field name="boteco_rateio_casa_pct"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
