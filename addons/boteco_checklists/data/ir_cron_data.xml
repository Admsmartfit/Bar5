<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_checklists_do_dia" model="ir.cron">
        <field name="name">Boteco: criar os checklists do dia</field>
        <field name="model_id" ref="model_boteco_checklist_execucao"/>
        <field name="state">code</field>
        <field name="code">model._cron_gerar()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_nao_conformidades" model="ir.cron">
        <field name="name">Boteco: lembrar não conformidades vencidas</field>
        <field name="model_id" ref="model_boteco_nao_conformidade"/>
        <field name="state">code</field>
        <field name="code">model._cron_lembrar()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
