<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boteco_nfe_importacao_view_form" model="ir.ui.view">
        <field name="name">boteco.nfe.importacao.form</field>
        <field name="model">boteco.nfe.importacao</field>
        <field name="arch" type="xml">
            <form string="Entrada pela nota do fornecedor">
                <p invisible="lido">Escolha o arquivo XML da NF-e (o fornecedor manda por e-mail). O sistema lê tudo sozinho.</p>
                <group>
                    <field name="arquivo" filename="nome_arquivo"/>
                    <field name="nome_arquivo" invisible="1"/>
                    <field name="lido" invisible="1"/>
                    <field name="criar_produtos"/>
                </group>
                <group invisible="not lido">
                    <group>
                        <field name="partner_id"/>
                        <field name="numero"/>
                    </group>
                    <group>
                        <field name="emissao"/>
                        <field name="total"/>
                        <field name="chave"/>
                    </group>
                </group>
                <field name="linha_ids" invisible="not lido">
                    <list editable="bottom" decoration-warning="not product_id">
                        <field name="codigo"/>
                        <field name="descricao"/>
                        <field name="quantidade"/>
                        <field name="unidade"/>
                        <field name="valor_total"/>
                        <field name="product_id" placeholder="Novo insumo será criado"/>
                        <field name="fator"/>
                    </list>
                </field>
                <footer>
                    <button name="action_ler" type="object" string="Ler a nota" class="btn-secondary" invisible="lido"/>
                    <button name="action_criar_entrada" type="object" string="Dar entrada no estoque" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_boteco_nfe_importacao" model="ir.actions.act_window">
        <field name="name">Entrada por XML da nota</field>
        <field name="res_model">boteco.nfe.importacao</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="boteco_nfe_produto_view_list" model="ir.ui.view">
        <field name="name">boteco.nfe.produto.list</field>
        <field name="model">boteco.nfe.produto</field>
        <field name="arch" type="xml">
            <list string="Produtos dos fornecedores" editable="bottom">
                <field name="partner_id"/>
                <field name="codigo"/>
                <field name="descricao"/>
                <field name="product_id"/>
                <field name="fator"/>
            </list>
        </field>
    </record>
    <record id="action_boteco_nfe_produto" model="ir.actions.act_window">
        <field name="name">Produtos dos fornecedores (de-para)</field>
        <field name="res_model">boteco.nfe.produto</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
