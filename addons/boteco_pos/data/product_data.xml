<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Produtos técnicos: não vão para produção nem aparecem no tablet -->
    <record id="produto_taxa_servico" model="product.product">
        <field name="name">Taxa de serviço</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="available_in_pos" eval="True"/>
        <field name="self_order_available" eval="False"/>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="taxes_id" eval="[Command.clear()]"/>
        <field name="default_code">TAXA-SERVICO</field>
    </record>

    <record id="produto_couvert" model="product.product">
        <field name="name">Couvert artístico</field>
        <field name="type">service</field>
        <field name="list_price">10.0</field>
        <field name="available_in_pos" eval="True"/>
        <field name="self_order_available" eval="False"/>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="taxes_id" eval="[Command.clear()]"/>
        <field name="default_code">COUVERT</field>
    </record>
</odoo>
