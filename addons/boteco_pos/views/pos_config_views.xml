<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_boteco" model="ir.ui.view">
        <field name="name">pos.config.form.boteco</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Boteco" name="boteco">
                    <group>
                        <field name="boteco_taxa_servico_pct"/>
                        <field name="boteco_produto_taxa_id"/>
                        <field name="boteco_taxa_no_balcao"/>
                        <field name="boteco_produto_couvert_id"/>
                    </group>
                    <group>
                        <field name="boteco_minutos_atraso"/>
                        <field name="boteco_contagem_cega"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
