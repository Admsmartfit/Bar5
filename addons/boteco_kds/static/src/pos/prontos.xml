<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="boteco_kds.ProntosPopup">
        <Dialog title="'Prontos para entregar'" size="'lg'">
            <div t-if="state.carregando" class="text-center p-4">Carregando…</div>
            <div t-elif="!state.tickets.length" class="text-center p-4 fs-4">Nada esperando entrega. 👍</div>
            <div class="d-grid gap-2">
                <div t-foreach="state.tickets" t-as="t" t-key="t.id" class="border rounded p-2 d-flex align-items-center gap-3">
                    <div class="flex-grow-1">
                        <div class="fs-3 fw-bold"><t t-esc="t.mesa"/> <small class="text-muted text-uppercase fs-6" t-esc="t.setor"/></div>
                        <div class="fs-5">
                            <t t-foreach="t.itens" t-as="i" t-key="i.id"><t t-esc="i.quantidade"/>× <t t-esc="i.nome"/><t t-if="!i_last">, </t></t>
                        </div>
                    </div>
                    <button class="btn btn-success btn-lg px-4" style="min-height:64px" t-on-click="() => this.entregar(t)">Entregue</button>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary btn-lg" t-on-click="props.close">Fechar</button>
            </t>
        </Dialog>
    </t>

    <t t-name="boteco_kds.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('status-buttons')]" position="inside">
            <button class="btn btn-light btn-lg position-relative o_boteco_btn_prontos" t-on-click="() => this.pos.botecoAbrirProntos()"
                    title="Prontos para entregar">
                <i class="fa fa-bell"/>
                <span t-if="botecoQtdProntos" class="badge rounded-pill text-bg-success position-absolute top-0 start-100 translate-middle"
                      t-esc="botecoQtdProntos"/>
            </button>
        </xpath>
    </t>
</templates>
