<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout_boteco" name="Boteco: layout de tela cheia">
        &lt;!DOCTYPE html&gt;
        <html lang="pt-BR" t-att-data-tema="tema or 'escuro'">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" content="#111827"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <title t-esc="titulo or 'Boteco'"/>
                <t t-call-assets="boteco_base.assets_pin" t-js="false"/>
                <t t-out="head or ''"/>
            </head>
            <body t-att-class="body_classe or ''">
                <t t-out="0"/>
                <t t-call-assets="boteco_base.assets_pin" t-css="false"/>
            </body>
        </html>
    </template>

    <template id="tela_pin" name="Boteco: entrar com PIN">
        <t t-call="boteco_base.layout_boteco">
            <t t-set="titulo">Entrar – Boteco</t>
            <t t-set="body_classe">bt-pin</t>
            <header class="bt-topo">
                <div class="bt-topo__marca" t-esc="empresa.name"/>
                <div class="bt-topo__relogio" id="bt-relogio">--:--</div>
            </header>

            <main class="bt-pin__corpo">
                <section id="bt-pessoas" class="bt-pin__pessoas" aria-label="Quem é você?">
                    <h1 class="bt-titulo">Quem é você?</h1>
                    <p t-if="not pessoas" class="bt-vazio">
                        Ninguém cadastrado com PIN ainda. O dono cadastra em Boteco › Pessoas.
                    </p>
                    <div class="bt-grade">
                        <t t-foreach="pessoas" t-as="p">
                            <button type="button" class="bt-pessoa" t-att-data-id="p['id']" t-att-data-nome="p['nome']"
                                    t-att-data-perfil="p['codigo_perfil']">
                                <span class="bt-pessoa__avatar" t-esc="p['iniciais']"/>
                                <span class="bt-pessoa__nome" t-esc="p['nome']"/>
                                <span class="bt-pessoa__perfil" t-esc="p['perfil']"/>
                            </button>
                        </t>
                    </div>
                    <a class="bt-link" href="/web/login">Entrar com senha (dono)</a>
                </section>

                <section id="bt-teclado" class="bt-pin__teclado" hidden="hidden" aria-live="polite">
                    <button type="button" class="bt-voltar" id="bt-voltar" aria-label="Voltar">‹ Trocar pessoa</button>
                    <h1 class="bt-titulo" id="bt-nome-escolhido"/>
                    <div class="bt-pontos" id="bt-pontos" aria-label="PIN digitado">
                        <span/><span/><span/><span/><span/><span/>
                    </div>
                    <p class="bt-erro" id="bt-erro" role="alert"/>
                    <button type="button" class="bt-link" id="bt-desbloquear" hidden="hidden">Gerente desbloqueia aqui</button>
                    <div class="bt-numpad">
                        <t t-foreach="['1','2','3','4','5','6','7','8','9']" t-as="n">
                            <button type="button" class="bt-tecla" t-att-data-tecla="n" t-esc="n"/>
                        </t>
                        <button type="button" class="bt-tecla bt-tecla--apagar" data-tecla="apagar" aria-label="Apagar">⌫</button>
                        <button type="button" class="bt-tecla" data-tecla="0">0</button>
                        <button type="button" class="bt-tecla bt-tecla--ok" data-tecla="ok" aria-label="Entrar">Entrar</button>
                    </div>
                </section>
            </main>
        </t>
    </template>
</odoo>
