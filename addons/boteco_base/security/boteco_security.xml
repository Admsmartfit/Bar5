<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_boteco" model="ir.module.category">
        <field name="name">Boteco</field>
        <field name="description">Perfis do Sistema Boteco Raiz</field>
        <field name="sequence">1</field>
    </record>

    <!-- Perfis da seção 3 do PRD. Cada perfil tem um grupo; o perfil define TODOS os acessos. -->
    <record id="group_garcom" model="res.groups">
        <field name="name">Garçom</field>
        <field name="category_id" ref="module_category_boteco"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('point_of_sale.group_pos_user'))]"/>
        <field name="comment">Mapa de mesas, lançar e entregar itens, aprovar celular do QR.</field>
    </record>

    <record id="group_caixa" model="res.groups">
        <field name="name">Barman / caixa</field>
        <field name="category_id" ref="module_category_boteco"/>
        <field name="implied_ids" eval="[Command.link(ref('group_garcom'))]"/>
        <field name="comment">Tudo do garçom + receber pagamento, sangria e reforço.</field>
    </record>

    <record id="group_chapeiro" model="res.groups">
        <field name="name">Chapeiro</field>
        <field name="category_id" ref="module_category_boteco"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Só a fila da chapa (tela de produção).</field>
    </record>

    <record id="group_gerente" model="res.groups">
        <field name="name">Gerente</field>
        <field name="category_id" ref="module_category_boteco"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_caixa')),
            Command.link(ref('group_chapeiro')),
            Command.link(ref('stock.group_stock_user')),
            Command.link(ref('purchase.group_purchase_user')),
        ]"/>
        <field name="comment">Cancelar com motivo, desconto, cortesia, abrir e fechar caixa, ajustar estoque.</field>
    </record>

    <record id="group_cozinheiro" model="res.groups">
        <field name="name">Cozinheiro (cozinha central)</field>
        <field name="category_id" ref="module_category_boteco"/>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('mrp.group_mrp_user')),
            Command.link(ref('stock.group_stock_user')),
        ]"/>
        <field name="comment">Produzir lote, imprimir etiqueta, registrar perda e temperatura.</field>
    </record>

    <record id="group_comercial" model="res.groups">
        <field name="name">Comercial B2B</field>
        <field name="category_id" ref="module_category_boteco"/>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('sales_team.group_sale_salesman_all_leads')),
            Command.link(ref('stock.group_stock_user')),
            Command.link(ref('account.group_account_invoice')),
        ]"/>
        <field name="comment">Clientes e pedidos de outros bares, entregas.</field>
    </record>

    <!-- Etapa 34: contador só vê Finanças (fiscal e relatórios) -->
    <record id="group_contador" model="res.groups">
        <field name="name">Contador</field>
        <field name="category_id" ref="module_category_boteco"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Só Finanças: fiscal (exportar e importar retorno) e relatórios.</field>
    </record>

    <record id="group_dono" model="res.groups">
        <field name="name">Dono / administrador</field>
        <field name="category_id" ref="module_category_boteco"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_gerente')),
            Command.link(ref('group_cozinheiro')),
            Command.link(ref('group_comercial')),
            Command.link(ref('group_contador')),
            Command.link(ref('base.group_system')),
            Command.link(ref('base.group_erp_manager')),
            Command.link(ref('point_of_sale.group_pos_manager')),
            Command.link(ref('stock.group_stock_manager')),
            Command.link(ref('purchase.group_purchase_manager')),
            Command.link(ref('mrp.group_mrp_manager')),
            Command.link(ref('sales_team.group_sale_manager')),
            Command.link(ref('account.group_account_manager')),
        ]"/>
        <field name="comment">Tudo, inclusive pessoas, preços, fiscal e configurações.</field>
    </record>

    <!-- O usuário admin vira dono -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[Command.link(ref('group_dono'))]"/>
    </record>

    <!-- Regras multiempresa -->
    <record id="regra_auditoria_empresa" model="ir.rule">
        <field name="name">Auditoria: empresas permitidas</field>
        <field name="model_id" ref="model_boteco_auditoria"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regra_impressora_empresa" model="ir.rule">
        <field name="name">Impressora: empresas permitidas</field>
        <field name="model_id" ref="model_boteco_impressora"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regra_setor_empresa" model="ir.rule">
        <field name="name">Setor: empresas permitidas</field>
        <field name="model_id" ref="model_boteco_setor"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
