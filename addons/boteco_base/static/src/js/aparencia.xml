<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="boteco_base.Aparencia">
        <Dropdown position="'bottom-end'" menuClass="'o_bt_aparencia'">
            <button type="button" class="btn btn-link o_boteco_systray__btn" title="Aparência (tema, contraste e letra)">
                <i t-attf-class="fa {{ icone }}"/>
            </button>
            <t t-set-slot="content">
                <div class="o_bt_aparencia__titulo">Tema</div>
                <div class="o_bt_aparencia__grupo">
                    <button t-foreach="temas" t-as="t" t-key="t.codigo" type="button"
                            t-attf-class="o_bt_aparencia__opcao {{ state.tema === t.codigo ? 'ativo' : '' }}"
                            t-on-click="() => this.mudar('tema', t.codigo)">
                        <i t-attf-class="fa {{ t.icone }}"/> <t t-esc="t.nome"/>
                    </button>
                </div>

                <div class="o_bt_aparencia__linha mt-2">
                    <label class="fw-bold mb-0" for="bt_alto_contraste">Alto contraste</label>
                    <div class="form-check form-switch mb-0">
                        <input id="bt_alto_contraste" class="form-check-input" type="checkbox" role="switch"
                               t-att-checked="state.alto_contraste"
                               t-on-change="(ev) => this.mudar('alto_contraste', ev.target.checked)"/>
                    </div>
                </div>

                <div class="o_bt_aparencia__titulo">Tamanho da letra</div>
                <div class="o_bt_aparencia__grupo">
                    <button t-foreach="fontes" t-as="f" t-key="f.codigo" type="button"
                            t-attf-class="o_bt_aparencia__opcao {{ state.fonte === f.codigo ? 'ativo' : '' }}"
                            t-on-click="() => this.mudar('fonte', f.codigo)">
                        <t t-esc="f.nome"/>
                    </button>
                </div>

                <div class="o_bt_aparencia__titulo">Cor de destaque</div>
                <div class="o_bt_aparencia__grupo">
                    <button t-foreach="cores" t-as="c" t-key="c.codigo" type="button" t-att-title="c.nome"
                            t-att-aria-label="c.nome"
                            t-attf-class="o_bt_aparencia__cor {{ state.cor === c.codigo ? 'ativo' : '' }}"
                            t-attf-style="background: {{ c.hex }};"
                            t-on-click="() => this.mudar('cor', c.codigo)"/>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
